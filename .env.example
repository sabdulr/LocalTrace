# Exact browser address; no trailing slash. Replace with your Ubuntu server IP.
PUBLIC_ORIGIN=http://192.168.1.50:4173
WEB_PORT=4173
# Use 127.0.0.1 when a reverse proxy on the host provides HTTPS/authentication.
BIND_ADDRESS=0.0.0.0
# For CPUs/VMs without x86-64-v2/SSE4.2, uncomment the source-build image:
# LOCALTRACE_DOCKERFILE=Dockerfile.compat
